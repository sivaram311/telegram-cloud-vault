# Telegram API Credentials (Obtain from https://my.telegram.org)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=your_phone_number_with_country_code

# rclone Target Configuration
# Format: <remote_name>:<remote_subfolder>
RCLONE_REMOTE=gdrive-crypt:TelegramBackup

# Download Settings
LOCAL_TEMP_DIR=temp_downloads
MAX_FILE_SIZE_MB=2000
